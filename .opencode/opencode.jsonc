{
  "$schema": "https://opencode.ai/config.json",
  // Project-only MCP configuration. This server is not added to the global
  // OpenCode config, so other projects do not see it.
  "mcp": {
    "servers": {
      "godot-mcp-toolkit": {
        "type": "local",
        "command": ["npx", "-y", "@npgamedev/godot-mcp-server@1.1.2"],
        "environment": {
          "GODOT_MCP_CONFIG_VERSION": "1",
          "npm_config_prefer_offline": "true"
        }
      }
    }
  }
}
