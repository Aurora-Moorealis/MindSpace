class_name LunarMapWorld
extends Node2D
## Playable world for a procedurally generated lunar map.
##
## On [method _ready] the world generates a [LunarMap] from [member config]
## (or from the default configuration when it is null), paints the three tile
## layers through [LunarMapTileRenderer] and moves its [Camera2D] to the centre
## of the spawn tile. The scene owns the layers, their TileSets and the camera;
## the generation and painting logic stays in their dedicated classes.

## Configuration used to build the map. A null value means defaults.
@export var config: LunarMapConfig

## Map generated by this world, or null before [method _ready] runs.
var map: LunarMap

@onready var _ground: TileMapLayer = $Ground
@onready var _base: TileMapLayer = $Base
@onready var _props: TileMapLayer = $Props
@onready var _camera: Camera2D = $Camera2D


func _ready() -> void:
	var effective_config: LunarMapConfig = config
	if effective_config == null:
		effective_config = LunarMapConfig.new()
	map = LunarMapGenerator.generate(effective_config)
	LunarMapTileRenderer.paint(map, _ground, _base, _props)

	var tile_extent: Vector2 = Vector2(float(map.tile_size), float(map.tile_size))
	_camera.position = map.tile_to_world(map.spawn_tile) + tile_extent * 0.5
	_camera.zoom = Vector2(1.0, 1.0)
	_camera.enabled = true
	_camera.make_current()


## Returns the generated map, or null before [method _ready] runs.
func get_map() -> LunarMap:
	return map
